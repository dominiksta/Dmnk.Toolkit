@using System.ComponentModel
@using Dmnk.Blazor.Mvvm;
@using Dmnk.Toolkit.TestUtil
@using Microsoft.Extensions.Logging
@inherits BunitContext

@code {
    private readonly InMemoryLogger<ViewModelRegistry> _logger = new();
    private IViewModelRegistry _registry = null!;
    
    [OneTimeSetUp]
    public void OneTimeSetUp()
    {
        var registry = new ViewModelRegistry([
            ViewModelRegistration.Create<SpecificViewModel1, SpecificView1>(),
            ViewModelRegistration.Create<SpecificViewModel2, SpecificView2>()
        ], _logger);
        _registry = registry;
    }
    
    [Test]
    public void Should_Render_Specific_View_For_Registered_ViewModel()
    {
        // Act
        var cut1 = Render(@<RegisteredViewFor Vm="new SpecificViewModel1()" Registry="_registry"/>);
        INotifyPropertyChanged vm2 = new SpecificViewModel2();
        var cut2 = Render(@<RegisteredViewFor Vm="vm2" Registry="_registry"/>);
        var cut3 = Render(@<RegisteredViewFor Vm="new SpecificViewModel2()" Registry="_registry"/>);

        // Assert
        Assert.Multiple(() =>
        {
            Assert.That(cut1.Find("h3").TextContent, 
                Is.EqualTo("Specific View 1 (Name: SpecificViewModel1)"));
            Assert.That(cut2.Find("h3").TextContent, 
                Is.EqualTo("Specific View 2 (Name: SpecificViewModel2)"));
            Assert.That(cut3.Find("h3").TextContent, 
                Is.EqualTo("Specific View 2 (Name: SpecificViewModel2)"));
        });
    }
    
    [Test]
    public void Should_Log_Error_On_Duplicate_Registration()
    {
        var logger = new InMemoryLogger<ViewModelRegistry>();
        var services = new ServiceCollection();
        services.AddSingleton<ILogger<ViewModelRegistry>>(logger);
        services.AddBlazorMvvm();
        
        services.AddViewModelRegistration<SpecificViewModel1, SpecificView1>();
        services.AddViewModelRegistration<SpecificViewModel1, SpecificView1>();
        
        var provider = services.BuildServiceProvider();
        
        var registry = provider.GetRequiredService<IViewModelRegistry>();
        registry.GetViewForViewModel(new SpecificViewModel1());
        
        // Assert
        Assert.That(logger.Messages, Has.Exactly(1).Matches<InMemoryLogMessage>(
            entry => entry.Level == LogLevel.Error 
                     && entry.Message.ToLowerInvariant().Contains("duplicate")));
    }
    
    [Test]
    public void Should_Return_Null_For_Unregistered_ViewModel()
    {
        // Act
        var viewType = _registry.GetViewForViewModelDynamic(typeof(UnregisteredViewModel));
        
        // Assert
        Assert.That(viewType, Is.Null);    
    }
    
    [Test]
    public void Should_Show_Error_Message_When_Rendering_Unregistered_ViewModel()
    {
        var vm = new UnregisteredViewModel();

        // Act
        var cut = Render(@<RegisteredViewFor Vm="vm" Registry="_registry"/>);

        // Assert
        Assert.Multiple(() =>
        {
            var text = cut.Find("ul").TextContent;
            Assert.That(text, Does.Contain("PROGRAM ERROR"));
            Assert.That(text, Does.Contain(vm.ToString()));
            Assert.That(text, Does.Contain("{")); // json
        });
    }

    [Test]
    public void Open_Generic_Should_Resolve_Closed_View_From_Manual_Registration()
    {
        var registry = new ViewModelRegistry([
            ViewModelRegistration.CreateOpenGeneric(typeof(GenericViewModel<>), typeof(GenericView<>))
        ], _logger);

        var vmStr = new GenericViewModel<string>();
        var vmInt = new GenericViewModel<int>();

        var cutStr = Render(@<RegisteredViewFor Vm="vmStr" Registry="registry"/>);
        var cutInt = Render(@<RegisteredViewFor Vm="vmInt" Registry="registry"/>);

        Assert.Multiple(() =>
        {
            Assert.That(cutStr.Find("h3").TextContent, Is.EqualTo("Generic View (T: String)"));
            Assert.That(cutInt.Find("h3").TextContent, Is.EqualTo("Generic View (T: Int32)"));
        });
    }
    
}