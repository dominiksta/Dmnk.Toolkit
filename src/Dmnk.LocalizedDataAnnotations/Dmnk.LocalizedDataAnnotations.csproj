<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"
                          Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Properties\I18nLocalizedDataAnnotations.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>I18nLocalizedDataAnnotations.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Properties\I18nLocalizedDataAnnotations.de.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>I18nLocalizedDataAnnotations.de.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Properties\I18nLocalizedDataAnnotations.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>I18nLocalizedDataAnnotations.resx</DependentUpon>
      </Compile>
      <Compile Update="Properties\I18nLocalizedDataAnnotations.de.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>I18nLocalizedDataAnnotations.de.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
