<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Dmnk.LocalizedDataAnnotations</PackageId>
        <Version>0.0.1</Version>
        <Authors>Dominik Stahmer</Authors>
        <Description>
            Localization for System.ComponentModel.DataAnnotations
        </Description>
        <PackageTags>Localization;DataAnnotations;Validation</PackageTags>

        <PackageReleaseNotes>
            Initial release.
        </PackageReleaseNotes>

        <RepositoryUrl>
            https://github.com/dominiksta/Dmnk.Toolkit
        </RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>_readme_nuget.md</PackageReadmeFile>
        <PackageProjectUrl>https://dominiksta.github.io/Dmnk.Toolkit</PackageProjectUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageTags>Localization;DataAnnotations;Validation</PackageTags>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0"
                          Condition="'$(TargetFramework)' == 'netstandard2.0'"/>
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Update="Properties\I18nLocalizedDataAnnotations.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>I18nLocalizedDataAnnotations.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Properties\I18nLocalizedDataAnnotations.de.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>I18nLocalizedDataAnnotations.de.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Properties\I18nLocalizedDataAnnotations.fr.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>I18nLocalizedDataAnnotations.fr.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>
    
    <ItemGroup>
      <Compile Update="Properties\I18nLocalizedDataAnnotations.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>I18nLocalizedDataAnnotations.resx</DependentUpon>
      </Compile>
      <Compile Update="Properties\I18nLocalizedDataAnnotations.de.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>I18nLocalizedDataAnnotations.de.resx</DependentUpon>
      </Compile>
      <Compile Update="Properties\I18nLocalizedDataAnnotations.fr.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>I18nLocalizedDataAnnotations.fr.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\_readme_nuget.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
