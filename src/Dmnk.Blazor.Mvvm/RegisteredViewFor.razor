@using System.ComponentModel
@using System.Text.Json
@using Microsoft.Extensions.Logging
@typeparam TViewModel where TViewModel : INotifyPropertyChanged

@if (_viewType != null)
{
    <DynamicComponent Type="_viewType" Parameters="_parameters"/>
}
else
{
    <ul style="color: white; background: red;">
        <li>PROGRAM ERROR: No view registered for view model of type @Vm.GetType().FullName</li>
        <li>ToString(): <pre>@Vm.ToString()</pre></li>
        <li>
            Data: 
            @try 
            {
                <pre>@JsonSerializer.Serialize(Vm)</pre>
            }
            catch
            {
                <pre>Not serializable</pre>
            }
        </li>
    </ul>
}

@code {
    /// <summary>
    /// The ViewModel to display with its associated view.
    /// </summary>
    [Parameter, EditorRequired] public required TViewModel Vm { get; set; }
    
    /// <summary>
    /// A registry may be either provided via DI or passed directly as a parameter (which take
    /// precedence over the DI registry). The registry is used to determine which view to display
    /// for the given view model.
    /// </summary>
    [Parameter] public required IViewModelRegistry? Registry { get; set; }
    
    private Type? _viewType = null;
    private readonly Dictionary<string, object> _parameters = new();

    protected override void OnInitialized()
    {
        var registry = Registry ?? viewModelRegistry ?? 
            throw new ArgumentException(
            "No registry provided. Either pass a registry via the Registry parameter or ensure " +
            "a registry is registered in the service provider.");
        
        _parameters[nameof(Vm)] = Vm;
        _viewType = registry.GetViewForViewModelDynamic(Vm.GetType());
        if (_viewType == null)
        {
            logger?.LogError(
                "No view registered for view model of type {ViewModelType}", 
                Vm.GetType().FullName);
        }
    }
}