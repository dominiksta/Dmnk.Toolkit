<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Dmnk.Blazor.Mvvm</PackageId>
        <Version>0.0.4</Version>
        <Authors>Dominik Stahmer</Authors>
        <Description>Base types for using MVVM in Blazor.</Description>
        <PackageTags>Blazor;MVVM;Model-View-ViewModel</PackageTags>
        
        <PackageReleaseNotes>
            **Fixed:**

            - `RegisteredViewFor` now properly updates the view when the ViewModel changes, 
               e.g. using in a `@foreach`
        </PackageReleaseNotes>
        
        <RepositoryUrl>
            https://github.com/dominiksta/Dmnk.Toolkit
        </RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>_readme_nuget.md</PackageReadmeFile>
        <PackageProjectUrl>https://dominiksta.github.io/Dmnk.Toolkit</PackageProjectUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    
    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <InternalsVisibleTo Include="Dmnk.Blazor.Mvvm.Tests" />
    </ItemGroup>

    <!-- Source Generator Reference -->
    <ItemGroup>
        <ProjectReference Include="..\Dmnk.Blazor.Mvvm.SourceGen\Dmnk.Blazor.Mvvm.SourceGen.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup Label="Pack Source Generator into NuGet">
        <!-- Include the source generator DLL in the NuGet package so consumers get it automatically -->
        <None Include="..\Dmnk.Blazor.Mvvm.SourceGen\bin\$(Configuration)\netstandard2.0\Dmnk.Blazor.Mvvm.SourceGen.dll"
              PackagePath="analyzers\dotnet\roslyn4.0\cs"
              Pack="true"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\_readme_nuget.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
